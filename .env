# --- service
AEGIS_API_KEY=                    # REQUIRED in production (empty = auth disabled, dev only). Use a long random value.
AEGIS_RATE_PER_MIN=60             # per client; per process
AEGIS_TRUST_PROXY=false           # true only behind a proxy you control (uses X-Forwarded-For for rate limiting)
AEGIS_CORS_ORIGINS=               # comma-separated; empty = same-origin only
AEGIS_MAX_QUESTION_CHARS=600
AEGIS_LOG_LEVEL=INFO
# --- LLM (optional; the deterministic path works without it)
ANTHROPIC_API_KEY=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
AEGIS_LLM_ENABLED=true
AEGIS_LLM_MODELS=claude-sonnet-5-5,claude-haiku-4-5-20251001     # fallback chain; names are config, verify against your account
AEGIS_ANALYZER_MODE=rules_then_llm                               # rules | rules_then_llm | llm
AEGIS_LLM_TIMEOUT_S=30
AEGIS_LLM_MAX_RETRIES=3
AEGIS_LLM_BREAKER_FAILURES=5
AEGIS_LLM_BREAKER_COOLDOWN_S=30
AEGIS_LLM_HOURLY_TOKEN_CAP=2000000
AEGIS_PRICE_IN_PER_MTOK=0         # optional, for cost estimates only
AEGIS_PRICE_OUT_PER_MTOK=0
